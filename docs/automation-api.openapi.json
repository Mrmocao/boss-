  "openapi": "3.1.0",
  "info": {
    "title": "Recruiting AI Read-only API",
    "version": "1.0.0",
    "description": "Independent read-only listener. No raw messages, candidate names, credentials or mutations. See automation-api.md."
  },
  "servers": [
    {
