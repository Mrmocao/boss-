  "paths": {
    "/api/v1/snapshot": {
      "get": {
        "operationId": "snapshotRead",
        "summary": "Runtime overview",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; inspect freshness.stale",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "const": "v1"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "generatedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "snapshotRevision": {
                      "type": "string"
                    },
                    "freshness": {
                      "$ref": "#/components/schemas/Freshness"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Snapshot"
                    }
                  },
                  "required": [
                    "apiVersion",
                    "requestId",
                    "generatedAt",
                    "snapshotRevision",
                    "freshness",
                    "data"
                  ]
                }
              }
            }
          },
          "304": {
            "description": "Unchanged; no response body"
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Browser origin rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "GET only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Page snapshot changed; restart pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "120 requests per minute exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
