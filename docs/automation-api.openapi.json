  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Freshness": {
        "type": "object",
        "properties": {
          "stateAvailable": {
            "type": "boolean"
          },
          "stale": {
            "type": "boolean"
          },
          "lastObservationAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ProcessHealth": {
        "type": "object",
        "properties": {
          "running": {
            "type": "boolean"
          },
          "responsive": {
            "type": "boolean"
          },
          "heartbeatAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "heartbeatAgeMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ServiceHealth": {
        "type": "object",
        "properties": {
          "apiAvailable": {
            "type": "boolean"
          },
          "supervisor": {
            "$ref": "#/components/schemas/ProcessHealth"
          },
          "monitor": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessHealth"
              },
              {
                "type": "object",
                "properties": {
                  "health": {
                    "type": "string"
                  },
                  "reportedHealth": {
                    "type": "string"
                  },
                  "paused": {
                    "type": "boolean"
                  },
                  "lastErrorCode": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "mode": {
            "type": "string"
          },
          "automaticSendConfigured": {
            "type": "boolean"
          },
          "automaticProcessingActive": {
            "type": "boolean"
          },
          "lastObservationAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "observationAgeMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "observationFresh": {
            "type": "boolean"
          }
        }
      },
      "Conversation": {
        "type": "object",
        "properties": {
          "platformId": {
            "const": "boss"
          },
          "accountId": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "stage": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "humanHandoff": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "policy_question",
              "qualification_review",
              "identity_or_history",
              "delivery_verification",
              "assessment_or_attachment",
              "model_error",
              "manual_takeover",
              "needs_review",
              null
            ]
          },
          "lastMessageDirection": {
            "enum": [
              "incoming",
              "outgoing",
              "unknown",
              null
            ]
          },
          "admittedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
