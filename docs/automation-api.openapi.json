                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "API disabled or configuration/state unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
